{
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",

      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",

      "node --check *": "allow",
      "bash -n *": "allow",
      "zsh -n *": "allow",

      "npm run check": "allow",
      "pnpm run check": "allow"
    },
    "external_directory": {
      "/**": "ask",
      "/tmp/**": "allow"
    },
    "doom_loop": "ask"
  },
  "provider": {
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {}
  },
  "agent": {},
  "autoupdate": true
}